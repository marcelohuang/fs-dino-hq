{
  "_comment": "Stage 2, five supports per episode (reported configuration). Plans from fs-dino-hq make-episodes (docs/data.md). Select afterwards with fs-dino-hq select-stage2.",
  "synthetic_root": "${DATA_DIR}/synthetic",
  "train_plan": "${DATA_DIR}/episodes/train_episode_plan_5shot_8cyc.csv",
  "n_shot": 5,
  "val_plans": [
    "val5=${DATA_DIR}/episodes/val_episode_plan_5shot.csv:5",
    "val1=${DATA_DIR}/episodes/val_episode_plan_1shot.csv:1"
  ],
  "select_on": "val5",
  "split_manifest": "${DATA_DIR}/episodes/synthetic_train_manifest.csv",
  "split_audit": "${DATA_DIR}/episodes/split_audit_5shot_8cyc.json",
  "adapter_ckpt": "${OUTPUT_DIR}/distill_final_adapter/final_adapter_best.pt",
  "dino_ckpt": "${WEIGHTS_DIR}/dinov2_vitb14_pretrain.pth",
  "sam_ckpt": "${WEIGHTS_DIR}/sam_vit_h_4b8939.pth",
  "save_dir": "${OUTPUT_DIR}/stage2_five_shot",
  "epochs": 200,
  "episodes_per_epoch": 2000,
  "val_episodes": 300,
  "full_val_every": 5,
  "best_selection": "full_val",
  "batch_size": 2,
  "lr": 0.0001,
  "weight_decay": 0.0001,
  "seed": 42,
  "num_workers": 6,
  "print_every": 100,
  "dino_size": 518,
  "feat_hw": 37,
  "ckpt_prefix": "stage2",
  "save_epochs": [50, 100, 150, 200],
  "save_every": 10,
  "adapter_norm_first": true,
  "adapter_dropout": 0.0
}
